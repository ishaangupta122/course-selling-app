// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Student {
    id           String       @id @default(cuid())
    name         String
    email        String
    password     String
    isActive     Boolean      @default(true)
    avatar       String?
    instructorId String?
    instructor   Instructor?  @relation(fields: [instructorId], references: [id], onDelete: SetNull)
    enrollments  Enrollment[]
    createdAt    DateTime     @default(now())
    updatedAt    DateTime     @updatedAt

    @@unique([email, instructorId])
    @@index([instructorId]) // index for frequent instructor-scoped student lookups
    @@index([email])        // index for signin queries
}

model Instructor {
    id           String    @id @default(cuid())
    name         String
    email        String    @unique
    password     String
    logo         String?
    organization String    @unique
    slug         String    @unique
    url          String?   @unique
    description  String?
    courses      Course[]
    students     Student[]
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt
}

model Admin {
    id        String   @id @default(cuid())
    name      String
    email     String   @unique
    password  String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Course {
    id            String         @id @default(cuid())
    instructorId  String
    instructor    Instructor     @relation(fields: [instructorId], references: [id], onDelete: Restrict)
    title         String
    description   String?
    price         Int
    thumbnailUrl  String
    level         Level?
    type          Type?
    startDate     DateTime?
    endDate       DateTime?
    enrollments   Enrollment[]
    courseFolders CourseFolder[]
    createdAt     DateTime       @default(now())
    updatedAt     DateTime       @updatedAt

    @@index([instructorId]) // index for fetching all courses by instructor
    @@index([level])        // index for filtering courses by level
}

model CourseFolder {
    id             String          @id @default(uuid())
    name           String
    courseId       String
    course         Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
    courseContents CourseContent[]

    @@unique([courseId, name])
    @@index([courseId]) // index for fetching folders of a course
}

model CourseContent {
    id             String       @id @default(uuid())
    name           String
    type           ContentType
    url            String
    position       Int          @default(0) // order within the folder
    courseFolderId String
    courseFolder   CourseFolder @relation(fields: [courseFolderId], references: [id], onDelete: Cascade)
    createdAt      DateTime     @default(now())
    updatedAt      DateTime     @updatedAt

    @@index([courseFolderId]) // index for fetching contents of a folder
}

model Enrollment {
    id         String   @id @default(cuid())
    studentId  String
    courseId   String
    student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
    course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
    enrolledAt DateTime @default(now())

    @@unique([studentId, courseId])
    @@index([studentId]) // index for fetching all enrollments of a student
    @@index([courseId])  // index for fetching all enrollments in a course
}

enum Level {
    BEGINNER
    INTERMEDIATE
    ADVANCED
}

enum Type {
    LIVE
    RECORDED
}

enum ContentType {
    VIDEO
    NOTES
}
